# Conexão com o banco. No Neon: use a URL "pooled" em DATABASE_URL e a "direct" em DATABASE_URL_UNPOOLED.
DATABASE_URL="postgresql://usuario:senha@host:5432/banco?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://usuario:senha@host:5432/banco?sslmode=require"

# E-mail (opcional). Sem estas variáveis, os e-mails ficam só registrados na
# caixa de saída (Usuários e permissões), sem envio.
# RESEND_API_KEY="re_..."
# EMAIL_REMETENTE="Orçamento de Obras <nao-responda@seudominio.com.br>"
# APP_URL="https://orca.yws.eng.br"
