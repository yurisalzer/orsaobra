{
  "name": "orcamento-obras",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:migrar": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "criar-admin": "tsx scripts/criar-admin.ts",
    "test": "dotenv -e .env.test -- sh -c \"prisma migrate deploy && vitest run\"",
    "test:unit": "vitest run tests/unit",
    "test:e2e": "playwright test",
    "postinstall": "node scripts/copiar-wasm.mjs",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@prisma/adapter-neon": "^6.19.3",
    "@prisma/adapter-pg": "^6.19.3",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "decimal.js": "^10.6.0",
    "docx": "^9.5.1",
    "exceljs": "^4.4.0",
    "fflate": "^0.8.3",
    "next": "15.5.28",
    "node-unrar-js": "^2.0.2",
    "pdfjs-dist": "^4.10.38",
    "pdfmake": "^0.3.11",
    "pg": "^8.23.1",
    "prisma": "^6.19.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "saxes": "^6.0.0",
    "server-only": "^0.0.1",
    "ws": "^8.22.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@opennextjs/cloudflare": "^1.20.12",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pdfmake": "^0.3.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.2",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "https-proxy-agent": "^9.1.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "undici": "^8.12.2",
    "vitest": "^3.2.7",
    "wrangler": "^4.151.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
